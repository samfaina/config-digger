{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config-digger Agent definition",
  "description": "Where an Agent keeps its configuration, in which format, and with what precedence.",
  "type": "object",
  "properties": {
    "format_version": {
      "description": "The version of this file format. Must be 1.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "agent": {
      "$ref": "#/$defs/AgentInfo"
    },
    "homes": {
      "description": "The Agent homes this Agent can have.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/HomeDefinition"
      }
    },
    "scopes": {
      "description": "The Scopes this Agent applies Entries at, in display order. A Scope is\nonly a label: precedence comes from the order of locations in `items`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScopeDefinition"
      }
    },
    "projects": {
      "description": "Where this Agent records the Projects it has been started on.",
      "$ref": "#/$defs/ProjectsDefinition"
    },
    "locations": {
      "description": "The configuration locations this Agent reads.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/LocationDefinition"
      }
    },
    "items": {
      "description": "Rules per Item kind.",
      "type": "object",
      "properties": {
        "mcp": {
          "$ref": "#/$defs/ItemRules"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "format_version",
    "agent",
    "homes",
    "scopes",
    "locations",
    "items"
  ],
  "$defs": {
    "AgentInfo": {
      "type": "object",
      "properties": {
        "id": {
          "description": "A stable id, such as `claude-code`.",
          "type": "string"
        },
        "name": {
          "description": "The display name, such as `Claude Code`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "HomeDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "roots": {
          "description": "Named roots of the home. The home is found when any root exists.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Locator"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "roots"
      ]
    },
    "Locator": {
      "description": "Where one root of an Agent home lives.",
      "oneOf": [
        {
          "description": "A fixed path below the user's home folder, written `~/<relative path>`.",
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "block": {
              "type": "string",
              "const": "path"
            }
          },
          "additionalProperties": false,
          "required": [
            "block",
            "path"
          ]
        }
      ]
    },
    "ScopeDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "ProjectsDefinition": {
      "type": "object",
      "properties": {
        "registries": {
          "description": "Each registry adds the Projects it records. Projects found by any Agent\nare evaluated for every Agent.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Registry"
          }
        }
      },
      "additionalProperties": false
    },
    "Registry": {
      "description": "Where an Agent records the Projects it has been started on.",
      "oneOf": [
        {
          "description": "The keys of an object in a strict JSON file, each one a Project path.",
          "type": "object",
          "properties": {
            "anchor": {
              "description": "Where the file is. It must not lie in a Project.",
              "$ref": "#/$defs/Anchor"
            },
            "root": {
              "description": "The key path of the object whose keys are Project paths.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "block": {
              "type": "string",
              "const": "json-keys"
            }
          },
          "additionalProperties": false,
          "required": [
            "block",
            "anchor",
            "root"
          ]
        }
      ]
    },
    "Anchor": {
      "description": "What a location's path is relative to.",
      "oneOf": [
        {
          "description": "A root of the Agent home, or a path below it.",
          "type": "object",
          "properties": {
            "root": {
              "description": "The name of a root declared by every home of the definition.",
              "type": "string"
            },
            "path": {
              "description": "A `/`-separated path relative to the root. Omitted when the root is the location.",
              "type": [
                "string",
                "null"
              ]
            },
            "block": {
              "type": "string",
              "const": "home"
            }
          },
          "additionalProperties": false,
          "required": [
            "block",
            "root"
          ]
        },
        {
          "description": "A path in the Project folder itself.",
          "type": "object",
          "properties": {
            "path": {
              "description": "A `/`-separated path relative to the Project folder.",
              "type": "string"
            },
            "block": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "block",
            "path"
          ]
        }
      ]
    },
    "LocationDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "root": {
          "description": "The key path of the object whose keys are Entries. One segment may be\n`{project}`: each key there is a Project path, and the Entries below it\napply only in that Project.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "scope": {
          "description": "The id of a declared Scope.",
          "type": "string"
        },
        "provenance": {
          "description": "The base Provenance of the location's Entries.",
          "$ref": "#/$defs/Provenance"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "anchor",
        "format",
        "root",
        "kind",
        "scope",
        "provenance"
      ]
    },
    "Format": {
      "description": "The file format and dialect a location is read in.",
      "oneOf": [
        {
          "description": "Strict JSON: no comments, no trailing commas.",
          "type": "object",
          "properties": {
            "block": {
              "type": "string",
              "const": "json"
            }
          },
          "additionalProperties": false,
          "required": [
            "block"
          ]
        }
      ]
    },
    "ItemKind": {
      "type": "string",
      "enum": [
        "mcp"
      ]
    },
    "Provenance": {
      "description": "How the Entries of a location got there, which decides how they can be taken away.",
      "oneOf": [
        {
          "description": "A key someone wrote into a configuration file, by hand or through the Agent.",
          "type": "string",
          "const": "file"
        }
      ]
    },
    "ItemRules": {
      "type": "object",
      "properties": {
        "precedence": {
          "description": "Location ids of this kind, highest precedence first.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "competition": {
          "$ref": "#/$defs/Competition"
        }
      },
      "additionalProperties": false,
      "required": [
        "precedence",
        "competition"
      ]
    },
    "Competition": {
      "description": "How same-kind Entries of one Agent home compete.",
      "oneOf": [
        {
          "description": "Entries compete when their names are exactly equal.",
          "type": "object",
          "properties": {
            "block": {
              "type": "string",
              "const": "exact-name"
            }
          },
          "additionalProperties": false,
          "required": [
            "block"
          ]
        }
      ]
    }
  }
}
