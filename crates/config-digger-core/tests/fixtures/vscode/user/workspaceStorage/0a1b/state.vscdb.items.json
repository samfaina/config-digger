{
  "mcp.extCachedServers": {
    "dart-code.dart-code/dart-sdk-mcp-servers": {
      "servers": [
        {
          "id": "dart-sdk-mcp-server",
          "label": "Dart SDK MCP Server",
          "cacheNonce": "1",
          "launch": {
            "type": 1,
            "command": "dart.exe",
            "args": ["mcp-server", "--api-key", "not-a-real-secret"],
            "env": { "DART_TOKEN": "not-a-real-secret" },
            "cwd": null
          }
        }
      ]
    },
    "github.copilot-chat/github": {
      "servers": [
        {
          "id": "github",
          "label": "github",
          "cacheNonce": "2",
          "launch": {
            "type": 2,
            "uri": {
              "$mid": 1,
              "external": "https://bot:not-a-real-secret@api.githubcopilot.com/mcp/?token%3Dnot-a-real-secret#t%3Dnot-a-real-secret",
              "path": "/mcp/",
              "scheme": "https",
              "authority": "bot:not-a-real-secret@api.githubcopilot.com",
              "query": "token=not-a-real-secret",
              "fragment": "t=not-a-real-secret"
            },
            "headers": [["Authorization", "Bearer not-a-real-secret"]]
          }
        }
      ]
    }
  }
}
