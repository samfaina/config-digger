{
  "manifest_version": "0.3",
  "name": "weather",
  "version": "1.0.0",
  "description": "Weather forecasts.",
  "author": {
    "name": "Toolbox"
  },
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ],
      "env": {
        "UNITS": "metric"
      }
    }
  }
}
