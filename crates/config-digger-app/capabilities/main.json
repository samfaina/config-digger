{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The only capability: the main window may call the task-level commands, nothing else.",
  "windows": ["main"],
  "permissions": [
    "allow-read-inventory",
    "allow-switch-project",
    "allow-backups-of",
    "allow-open-location",
    "allow-reveal-location",
    "allow-plan-action",
    "allow-execute-plan",
    "allow-cancel-plan",
    "allow-read-history",
    "allow-history-detail",
    "allow-dismiss-operation",
    "allow-read-places",
    "allow-change-list",
    "allow-check-home",
    "allow-check-project",
    "allow-pick-location",
    "allow-read-settings",
    "allow-save-settings",
    "allow-open-data-folder",
    "allow-read-about",
    "allow-open-page",
    "allow-update-status",
    "allow-startup-update-check",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-open-update-notes"
  ]
}
