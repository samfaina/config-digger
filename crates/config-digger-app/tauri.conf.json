{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "config-digger",
  "identifier": "io.github.samfaina.configdigger",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "config-digger",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640,
        "theme": "Dark",
        "backgroundColor": "#16171B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
