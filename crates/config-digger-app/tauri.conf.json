{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "config-digger",
  "identifier": "io.github.samfaina.configdigger",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "config-digger",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640,
        "theme": "Dark",
        "backgroundColor": "#16171B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "samfaina",
    "homepage": "https://github.com/samfaina/config-digger",
    "license": "MIT OR Apache-2.0",
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh",
        "languages": ["English"],
        "customLanguageFiles": { "English": "installer/English.nsh" }
      }
    }
  }
}
